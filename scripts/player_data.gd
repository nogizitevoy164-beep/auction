class_name PlayerData
extends RefCounted
## Игрок аукциона. Сейчас в игре 1 живой игрок («Вы») и 3 бота;
## в будущем боты заменятся настоящими игроками по сети —
## для этого достаточно заменить is_bot и подключить ввод по сети.

var id: int = 0
var player_name: String = ""
## true — управляется ИИ (бот), false — живой игрок.
var is_bot: bool = true
## Золото (монеты) игрока.
var gold: int = 0
## Путь к аватарке (res://icons/player_N.svg).
var avatar_path: String = ""
## Последняя ставка в текущем раунде (0 — допустимая нулевая ставка).
var last_bid: int = 0
## Решение в текущем раунде принято: ставка, в том числе нулевая.
var has_acted: bool = false
## Оценка стоимости лота ботом по открытым клеткам поля.
var last_estimate: int = 0
## Характер бота: 0.0 — осторожный, 1.0 — агрессивный.
var aggression: float = 0.5
## Снаряжение игрока (для будущих способностей: плащ, нагрудник и т.д.).
var equipment: Array = []
